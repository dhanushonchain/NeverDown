{
  "name": "@neverdown/web",
  "private": true,
  "version": "0.0.0",
  "description": "NeverDown console + five-act demo UI (C9)",
  "scripts": {
    "dev": "node ../../scripts/run-with-env.mjs web src/server.ts",
    "build": "tsc -p tsconfig.build.json",
