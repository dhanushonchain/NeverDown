{
  "name": "neverdown",
  "private": true,
  "version": "0.0.0",
  "description": "NeverDown — Autonomous Resilience Operator for Web3",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "npm run build --workspace=@neverdown/core && npm run build --workspace=@neverdown/sellers && npm run build --workspace=@neverdown/gateway && npm run build --workspace=@neverdown/web",
    "heroku-postbuild": "pnpm --filter @neverdown/sellers build",
    "dev": "npm run dev --workspace=@neverdown/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pay:once": "node scripts/run-with-env.mjs pay-once scripts/pay-once.ts",
    "policy:smoke": "node scripts/run-with-env.mjs policy-smoke scripts/policy-smoke.ts",
    "hcs:smoke": "node scripts/run-with-env.mjs hcs-smoke scripts/hcs-smoke.ts",
    "env:bootstrap": "node scripts/bootstrap-live-env.mjs",
    "arkiv:seed": "node scripts/run-with-env.mjs arkiv-seed scripts/seed-arkiv.ts",
    "arkiv:query": "node scripts/run-with-env.mjs agent scripts/query-arkiv.ts",
    "ens:check": "node scripts/run-with-env.mjs agent scripts/check-ens.ts",
    "ens:set-texts": "node scripts/run-with-env.mjs ens-set-texts scripts/set-ens-texts.ts",
    "preflight:live": "node scripts/run-with-env.mjs agent scripts/live-preflight.ts",
    "seller:live": "node scripts/run-with-env.mjs seller apps/sellers/src/server.ts",
    "gateway:live": "node scripts/run-with-env.mjs gateway apps/gateway/src/server.ts",
    "poc:smoke": "node scripts/run-with-env.mjs agent scripts/poc-smoke.ts",
    "agent:demo": "node scripts/run-with-env.mjs agent scripts/agent-demo.ts",
    "agent:live": "node scripts/run-with-env.mjs agent scripts/agent-demo.ts --scenario procure --live",
    "agent:deny-live": "node scripts/run-with-env.mjs agent scripts/agent-demo.ts --scenario deny --live",
    "coordinator:dev": "node scripts/run-with-env.mjs agent scripts/incident-coordinator.ts",
    "coordinator:live": "node scripts/run-with-env.mjs agent scripts/incident-coordinator.ts",
    "web:dev": "npm run dev --workspace=@neverdown/web",
    "test:core": "npm run test --workspace=@neverdown/core",
    "test:sellers": "npm run test --workspace=@neverdown/sellers",
    "test:gateway": "npm run test --workspace=@neverdown/gateway",
    "dev:all": "pnpm -r --parallel run dev",
    "start": "npm run start --workspace=@neverdown/web",
    "build:web": "pnpm --filter @neverdown/web build",
    "test": "npm run test --workspace=@neverdown/core && npm run test --workspace=@neverdown/sellers && npm run test --workspace=@neverdown/gateway && npm run test --workspace=@neverdown/web",
    "test:web": "npm run test --workspace=@neverdown/web",
    "test:smoke": "node scripts/smoke-web.mjs",
    "check:local": "pnpm typecheck && pnpm lint && pnpm test",
    "demo:local:setup": "node scripts/demo-local.mjs setup",
    "demo:local:status": "node scripts/demo-local.mjs status",
    "demo:local:reset": "node scripts/demo-local.mjs reset",
    "demo:local:seller": "node scripts/demo-service.mjs seller",
    "demo:local:gateway": "node scripts/demo-service.mjs gateway",
    "demo:local:web": "node scripts/demo-service.mjs web",
    "demo:local:rpc:primary": "node scripts/demo-service.mjs rpc-primary",
    "demo:local:rpc:standby": "node scripts/demo-service.mjs rpc-standby",
    "demo:ready": "node scripts/check-ready.mjs --demo",
    "test:local-demo": "node scripts/smoke-local-demo.mjs"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  },
  "pnpm": {
    "overrides": {
      "@hiero-ledger/sdk": "2.90.1",
      "@hiero-ledger/proto": "2.32.0"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@hiero-ledger/sdk": "2.90.1",
    "@hiero-ledger/proto": "2.32.0"
  }
}
