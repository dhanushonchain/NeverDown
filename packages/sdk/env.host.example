# NeverDown SDK — HOST process env (safe for NeverDown.create)
# Copy to .env.host and load into the app that imports @neverdown/sdk.
# Do NOT put HEDERA_SPEND_KEY / HEDERA_OPERATOR_KEY / ARKIV_PRIVATE_KEY here.

# Required
ENS_RPC_URL=https://ethereum-rpc.publicnode.com
ENS_ALLOWLIST_NAMES=neverdownseller.eth

# Required for proveCapability / procure
POC_REFERENCE_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Arkiv read (discoverOffers)
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=

# Required only for procure (path to the worker secrets file — not the secrets themselves)
PAYMENT_WORKER_ENV_FILE=./.env.worker
GATEWAY_URL=http://127.0.0.1:8787
GATEWAY_INTERNAL_TOKEN=replace-with-at-least-20-chars

# Optional helpers for examples
SELLER_ENS_NAME=neverdownseller.eth
HEDERA_MERCHANT_ACCOUNT_ID=0.0.11326899
HEDERA_X402_PRICE_SMALLEST_UNITS=10000
