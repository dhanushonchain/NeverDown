# NeverDown SDK — PAYMENT WORKER env file (mode 0600)
# Point PAYMENT_WORKER_ENV_FILE at this file from the host process.
# Never load these keys into the process that calls NeverDown.create.

HEDERA_NETWORK=testnet
HEDERA_SPEND_ID=
HEDERA_SPEND_KEY=
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Policy (bare Hedera account ids in ALLOWLIST)
POLICY_ALLOWLIST=0.0.11326899
POLICY_ENDPOINTS=https://your-seller.example.com
POLICY_SERVICES=neverdown-rpc-pack
POLICY_MAX_PER_PAYMENT_TINYBARS=10000
POLICY_TOTAL_BUDGET_TINYBARS=500000
POLICY_DB_PATH=neverdown-policy.sqlite
