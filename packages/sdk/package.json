{
  "name": "@neverdown/sdk",
  "version": "0.1.0",
  "description": "Server-side NeverDown resilience operator client",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/dhanushonchain/NeverDown.git", "directory": "packages/sdk" },
  "engines": { "node": ">=22.13.0" },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "import": "./dist/status.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@neverdown/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
